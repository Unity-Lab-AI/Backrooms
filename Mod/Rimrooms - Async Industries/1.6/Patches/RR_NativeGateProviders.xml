<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Exact Core providers only. Their new components remain dormant until explicit designation.
       The emergence component is added beside the gate one on the same two door defs: it is where
       a way out of the Backrooms comes up, and only ever on a door the player marked. -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Door"]/comps</xpath>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Door"]</xpath>
          <value><comps /></value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Door" or defName="Autodoor"]/comps</xpath>
        <value>
          <li Class="RimroomsAsyncIndustries.Gate.CompProperties_RimroomsGate" />
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Door" or defName="Autodoor"]/comps</xpath>
        <value>
          <li Class="RimroomsAsyncIndustries.Portals.CompProperties_RimroomsEmergence" />
        </value>
      </li>
      <!-- Owner direction 2026-09-29: "like orbital beacons to beable to show that available
           credits". A Core trade beacon already means "the valuables in this circle are the
           ones that count", so nobody has to learn a new idea and Core already draws the
           radius. Dormant until the player designates it, exactly like the gate comps above:
           a trade beacon in somebody's existing colony must behave as it always has. -->
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="OrbitalTradeBeacon"]/comps</xpath>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="OrbitalTradeBeacon"]</xpath>
          <value><comps /></value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="OrbitalTradeBeacon"]/comps</xpath>
        <value>
          <li Class="RimroomsAsyncIndustries.Economy.CompProperties_RimroomsCreditBeacon" />
        </value>
      </li>
      <!-- Owner direction 2026-09-29: "lost pawns". The comp sits on the human race def so
           every person in the game carries it, and it does nothing at all unless a coordinate
           marked that particular person as a survivor it produced. Same dormant-until-marked
           pattern as the gate and beacon comps above: installing this mod must never change
           anybody who was not asking for it. -->
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Human"]/comps</xpath>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Human"]</xpath>
          <value><comps /></value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Human"]/comps</xpath>
        <value>
          <li Class="RimroomsAsyncIndustries.Threats.CompProperties_RimroomsSurvivor" />
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="CommsConsole" or defName="TableMachining"]/comps</xpath>
        <value>
          <li Class="RimroomsAsyncIndustries.Gate.CompProperties_RimroomsGateConsole" />
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
