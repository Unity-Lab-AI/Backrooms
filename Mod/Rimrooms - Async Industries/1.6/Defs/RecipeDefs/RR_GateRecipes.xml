<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>RR_AssembleMachineGate</defName>
    <label>assemble gate</label>
    <description>Physically carry 100 steel and 8 industrial components to the designated machining table, then complete the installation assembly work. Designate the native door, communications console, battery and machining table in Operations first. The table retains its ordinary recipes.</description>
    <jobString>assembling the gate</jobString>
    <workAmount>6000</workAmount>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <workerClass>RimroomsAsyncIndustries.Gate.RecipeWorker_RimroomsGateAssembly</workerClass>
    <ingredients>
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>100</count>
      </li>
      <li>
        <filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter>
        <count>8</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers><li>TableMachining</li></recipeUsers>
  </RecipeDef>
</Defs>
