  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_ItemPacked</defName>
    <label>packed to carry</label>
    <description>Goods packed for carrying and then set down, in a space with nowhere to carry them.</description>
    <appliesTo>Item</appliesTo>
    <minDepth>2</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_ItemPackedText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <!-- ============================================================ equipment
       The owner named this specifically alongside items and benches. Equipment records a BODY:
       what size it is, and what it has been through. -->

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_EquipmentFitted</defName>
