  <!-- ============================================================ anything
       Tells about the object's relationship to the room rather than to its own kind, so they
       are true of a stool, a shelf and a steel stack alike. -->

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_AnyDust</defName>
    <label>the only clean thing</label>
