<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Owner direction 2026-10-04: "remember lsd unnerving feeling with all things ie events
       random spanwns, enemies, allies, nuetrals, even all the crazy things ive mentioned in the
       past and anything u can find in the many many prep docs on the Backrooms Universe", and
       the earlier line this file exists for: "not just room shape echoes but echos of thier
       inhabitance in weird ways and items and equipment and production benches".

       0.12.88-dev took the register to PEOPLE and EVENTS. It did not reach OBJECTS, and the
       owner had already named objects specifically. A coordinate was full of things that were
       materially varied, correctly placed, and said nothing about who had been using them.

       EVERY TELL IS ONE EXACT WRONG FACT. The rule is docs/UNIVERSE_ADAPTATION.md's, not
       invented here: "Ordinary industrial interiors become uncanny through exact changes." So
       no tell may contain a mood adjective - eerie, creepy, unsettling, strange, weird,
       sinister, ominous, uncanny, disturbing, horrifying, terrifying, unnerving. A bench that
       is "eerie" tells the player nothing. A bench whose bills are still queued for a meal
       nobody in this space could have ordered tells them something, and it says the same thing
       every time they come back to read it. proof-unnerving-register.py enforces this against
       the shipped Keyed XML.

       MOST OBJECTS CARRY NO TELL, and that is the design rather than a shortfall. The rule is
       the one CoordinatePressureLadder.IsQuietRoom already states - "quiet stretches are
       required content". See FixtureTellService.TellPercent: a small derived minority, chosen
       from the coordinate's own seed, so the same object says the same thing on every visit and
       the room next door says nothing at all.

       NOTHING HERE NAMES A ThingDef. appliesTo asks the definition a question - is this a work
       table, is this sittable, does this emit light - so a bench from a mod installed tomorrow
       is a bench today. Same discipline as RimroomsRoomArchetypeDef's capability slots.

       minDepth is never 1. The shallow yellow rooms stay plain, for the same reason every room
       archetype declares 2 or more: that emptiness IS the look, and a tell in the arrival hall
       would spend the setting's one surprise on a player's first thirty seconds. Measured
       against RoomArchetypeService.EffectiveDepth, so a room a dozen links out on a first level
       qualifies and the hall it leads back to does not. -->

  <!-- ============================================================ production benches
       The owner named these specifically, and they are the strongest of the classes: a bench
       records WORK, so a bench can record work that cannot have happened. -->

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_BenchQueued</defName>
    <label>queued bills</label>
    <description>A production bench whose outstanding bills describe work this space cannot support.</description>
    <appliesTo>Bench</appliesTo>
    <minDepth>2</minDepth>
    <weight>1.2</weight>
    <tellKey>RR_FixtureTell_BenchQueuedText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_BenchHanded</defName>
    <label>one-sided wear</label>
    <description>A bench worn down on one side only, as though everyone who ever used it stood the same way.</description>
    <appliesTo>Bench</appliesTo>
    <minDepth>2</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_BenchHandedText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_BenchClamped</defName>
    <label>half-finished work</label>
    <description>Something still clamped in the bench, with the rest of the cut never made.</description>
    <appliesTo>Bench</appliesTo>
    <minDepth>2</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_BenchClampedText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <!-- Deeper only. This is the branch's OWN work turning up, which is the owner's "echos of
       thier inhabitance" at its sharpest - and it has to be rare and late or the place stops
       being somewhere else and starts being a badly laid-out copy of the colony. The same
       reasoning caps RoomArchetypeService.EchoPercent at 40. -->
  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_BenchOurMarks</defName>
    <label>familiar tool marks</label>
    <description>A bench carrying the same tool marks as the one the branch uses at home.</description>
    <appliesTo>Bench</appliesTo>
    <minDepth>4</minDepth>
    <weight>0.7</weight>
    <tellKey>RR_FixtureTell_BenchOurMarksText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <!-- ============================================================ seating and tables
       Furniture records POSTURE - where somebody sat, how long, and facing what. -->

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_SeatWorn</defName>
    <label>worn seat, clean floor</label>
    <description>A seat worn through by long use, standing on floor that shows none of it.</description>
    <appliesTo>Seat</appliesTo>
    <minDepth>2</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_SeatWornText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_SeatFacing</defName>
    <label>turned to the wall</label>
    <description>A seat turned to face the wall, in company with every other seat in the space.</description>
    <appliesTo>Seat</appliesTo>
    <minDepth>3</minDepth>
    <weight>0.9</weight>
    <tellKey>RR_FixtureTell_SeatFacingText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_TableRings</defName>
    <label>identical cup rings</label>
    <description>Cup rings on a table, all the same size and none of them overlapping.</description>
    <appliesTo>Table</appliesTo>
    <minDepth>2</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_TableRingsText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_TableSet</defName>
    <label>set for a meal</label>
    <description>A table laid for several people, one of the places sized for a child.</description>
    <appliesTo>Table</appliesTo>
    <minDepth>3</minDepth>
    <weight>0.9</weight>
    <tellKey>RR_FixtureTell_TableSetText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <!-- ============================================================ beds -->

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_BedHandbook</defName>
    <label>made to the handbook</label>
    <description>A bed made up with the corners folded the way the company handbook specifies.</description>
    <appliesTo>Bed</appliesTo>
    <minDepth>3</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_BedHandbookText</tellKey>
