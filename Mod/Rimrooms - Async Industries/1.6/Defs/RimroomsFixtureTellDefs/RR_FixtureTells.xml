  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_BedImpression</defName>
    <label>short impression</label>
    <description>A slept-in bed holding the impression of somebody far shorter than it.</description>
    <appliesTo>Bed</appliesTo>
    <minDepth>2</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_BedImpressionText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <!-- ============================================================ storage
       Storage records INTENT - somebody decided what went where, and in what order. -->

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_StorageSorted</defName>
    <label>emptied in order</label>
    <description>Storage cleared out, with the empty containers put back in order afterwards.</description>
    <appliesTo>Storage</appliesTo>
    <minDepth>2</minDepth>
    <weight>1.1</weight>
    <tellKey>RR_FixtureTell_StorageSortedText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_StorageDated</defName>
    <label>dated ahead</label>
    <description>Storage labelled in the branch's own filing format, dated to a day that has not come.</description>
    <appliesTo>Storage</appliesTo>
    <minDepth>4</minDepth>
    <weight>0.7</weight>
    <tellKey>RR_FixtureTell_StorageDatedText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <!-- ============================================================ lights
       The owner's own example of how NOT to do this, inverted. The lights going out is not
       uncanny; the switches being found already off is. -->

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_LightSwitched</defName>
    <label>switched off, still warm</label>
    <description>A lamp found switched off, with the bulb still warm to the touch.</description>
    <appliesTo>Light</appliesTo>
    <minDepth>2</minDepth>
    <weight>1.2</weight>
    <tellKey>RR_FixtureTell_LightSwitchedText</tellKey>
