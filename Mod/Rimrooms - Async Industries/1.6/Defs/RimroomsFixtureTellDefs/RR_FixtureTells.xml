    <appliesTo>Light</appliesTo>
    <minDepth>2</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_LightReplacedText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

  <!-- ============================================================ loot
       The owner's "items" and "loot deeper in". An item records HANDLING. -->

  <RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>
    <defName>RR_FixtureTell_ItemCounted</defName>
    <label>counted and correct</label>
    <description>A stack counted out, with the count written beside it, and the count is right.</description>
    <appliesTo>Item</appliesTo>
    <minDepth>2</minDepth>
    <weight>1.1</weight>
    <tellKey>RR_FixtureTell_ItemCountedText</tellKey>
