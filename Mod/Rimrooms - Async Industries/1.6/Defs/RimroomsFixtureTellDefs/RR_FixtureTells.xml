    <appliesTo>Any</appliesTo>
    <minDepth>2</minDepth>
    <weight>1</weight>
    <tellKey>RR_FixtureTell_AnyMovedText</tellKey>
  </RimroomsAsyncIndustries.Generation.RimroomsFixtureTellDef>

</Defs>
