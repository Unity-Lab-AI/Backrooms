         night guard, mapped onto company roles the rest of the mod already understands, because
         a role here is an assignment rather than a class. -->
    <roles>
      <li>
        <id>operations</id><mustFight>false</mustFight>
        <skills><Social>7</Social><Intellectual>3</Intellectual></skills>
        <workTypes><li>Warden</li><li>Hauling</li></workTypes>
      </li>
      <li>
        <id>medical_logistics</id><mustFight>false</mustFight>
        <skills><Cooking>5</Cooking><Medicine>3</Medicine><Plants>3</Plants></skills>
        <workTypes><li>Cooking</li><li>Doctor</li><li>Growing</li></workTypes>
      </li>
      <li>
        <id>security</id><mustFight>true</mustFight>
        <skills><Shooting>5</Shooting><Melee>4</Melee></skills>
        <workTypes><li>Hauling</li></workTypes>
      </li>
    </roles>
    <!-- A shop's economy, not a research branch's. No corporate allocation: 200 silver in the
         till and whatever the stock is worth. Wages and overhead are three people and a
         building, which is why they are a fraction of Async's. -->
    <initialFundingUsd>200000</initialFundingUsd>
    <dailyWageUsd>300</dailyWageUsd>
    <dailyOverheadUsd>1500</dailyOverheadUsd>
    <surveyRewardUsd>500000</surveyRewardUsd>
    <surveyBonusUsd>100000</surveyBonusUsd>
  </RimroomsAsyncIndustries.Scenario.RimroomsStartDef>

  <!-- ==================================================================================== -->
  <!-- SOLO / GROUP - THE INSIDE START                                                      -->
  <!--                                                                                      -->
  <!-- Contract: docs/SCENARIOS.md, the lone_survivor card. The stable scenario ID is kept   -->
  <!-- because saves depend on it; the NAME is solo/group, on owner direction: "remember     -->
  <!-- the other one is solo/group start.. group have been known to end up together inside". -->
  <!--                                                                                      -->
  <!-- The map IS a Backrooms coordinate, wall to wall, so there is no layout to declare.    -->
  <!-- No corporation, no research, no facility, no gate and no way home. 1 to 5 people,     -->
  <!-- the player's choice, through the native config page.                                  -->
  <!--                                                                                      -->
  <!-- Funding is zero and overhead is zero, and both are deliberate: there is no company     -->
  <!-- here to run an account or bill a wage. Nobody is being paid and nobody is billing.     -->
  <!-- ==================================================================================== -->
  <RimroomsAsyncIndustries.Scenario.RimroomsStartDef>
    <defName>RR_SoloGroupStart</defName>
    <label>Solo or group, inside</label>
    <scenarioId>lone_survivor</scenarioId>
    <beginsInCorporationContact>false</beginsInCorporationContact>
    <defaultCompanyName>The ones who got in</defaultCompanyName>
    <scenarioVersion>1</scenarioVersion>
    <completedProjects />
    <insideStart>true</insideStart>
    <insideStartDepth>1</insideStartDepth>
    <mapSize>60</mapSize>
    <outdoorTerrain>Soil</outdoorTerrain>
    <floorTerrain>Concrete</floorTerrain>
    <wallStuff>BlocksGranite</wallStuff>
    <!-- The surface map holds ONE small concrete shell with ONE door, and nothing else. That
         door is the place the Backrooms comes up, and it is where they will come out. Everything
         a facility needs, they build.

         Reworked in 0.12.2-dev: the starting map used to BE the coordinate, which could never
         carry a registered exit. Now the coordinate is real and generated beside this map, and
         SoloGroupOpening moves everybody into it after registering the way out. -->
    <arrivalCell>(30, 0, 29)</arrivalCell>
    <stockCell>(30, 0, 31)</stockCell>
    <emergenceDoorCell>(30, 0, 27)</emergenceDoorCell>
    <rooms>
      <li><x>27</x><z>27</z><width>7</width><height>7</height><roofed>true</roofed><floor>true</floor></li>
    </rooms>
    <doors>
      <li>(30, 0, 27)</li>
    </doors>
    <buildings />
    <conduits />
    <roles>
      <li>
        <id>operations</id><mustFight>false</mustFight>
        <skills><Social>3</Social><Intellectual>3</Intellectual></skills>
        <workTypes><li>Hauling</li></workTypes>
      </li>
    </roles>
    <initialFundingUsd>0</initialFundingUsd>
    <dailyWageUsd>0</dailyWageUsd>
    <dailyOverheadUsd>0</dailyOverheadUsd>
    <surveyRewardUsd>500000</surveyRewardUsd>
    <surveyBonusUsd>100000</surveyBonusUsd>
  </RimroomsAsyncIndustries.Scenario.RimroomsStartDef>

</Defs>
