<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>RR_AsyncIndustries</defName>
    <label>Async Industries</label>
    <description>Lead an authorized research branch of Async Industries. Customize your starting people and supplies with native setup or optional Prepare Carefully, then review company roles and capabilities. Five colonists are the default; the company review supports 1 to 20 selected people without replacing them. A fixed small facility, unfinished machine, first survey and $50 million allocation await at your chosen surface tile. Supplies arrive physically with your people and remain editable separately from the fixed structures. This start uses a compact 60 by 60 headquarters; temperate conditions are recommended. Extra staff need additional beds and supplies. Small teams may need to hire before a full expedition.</description>
    <scenario>
      <summary>Customize your people and supplies, review company roles, and establish a $50 million research branch at your chosen surface tile. Five colonists by default; a fixed 60 by 60 headquarters.</summary>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>5</pawnCount>
          <pawnChoiceCount>10</pawnChoiceCount>
          <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
        </li>
        <li Class="RimroomsAsyncIndustries.Scenario.ScenPart_RimroomsStart">
          <def>RR_CompanyStart</def>
          <startDef>RR_AsyncIndustriesStart</startDef>
          <visible>false</visible>
        </li>
        <li Class="RimroomsAsyncIndustries.Scenario.ScenPart_RimroomsArrival">
          <def>RR_CompanyArrival</def>
          <method>Standing</method>
          <visible>false</visible>
        </li>
        <!-- Native parts stay visible/editable to scenario setup and Prepare Carefully. -->
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Steel</thingDef><count>250</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>ComponentIndustrial</thingDef><count>18</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>ComponentSpacer</thingDef><count>2</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Silver</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MealSurvivalPack</thingDef><count>50</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MedicineIndustrial</thingDef><count>6</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Gun_BoltActionRifle</thingDef><count>1</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Gun_Revolver</thingDef><count>1</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Apparel_FlakVest</thingDef><count>1</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WoodLog</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>RR_FieldRecorder</thingDef><count>1</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>RR_SurveyTag</thingDef><count>6</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>RR_SealedEvidenceCase</thingDef><count>1</count></li>
      </parts>
    </scenario>
  </ScenarioDef>
  <MapGeneratorDef>
    <defName>RR_Headquarters</defName>
    <genSteps>
      <li>RR_HeadquartersTerrain</li>
      <li>RR_HeadquartersFacility</li>
      <li>ScenParts</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>
  <GenStepDef>
    <defName>RR_HeadquartersTerrain</defName>
    <order>5</order>
    <genStep Class="RimroomsAsyncIndustries.Scenario.GenStep_HeadquartersTerrain" />
  </GenStepDef>
  <GenStepDef>
    <defName>RR_HeadquartersFacility</defName>
    <order>800</order>
    <genStep Class="RimroomsAsyncIndustries.Scenario.GenStep_HeadquartersFacility" />
  </GenStepDef>
</Defs>
