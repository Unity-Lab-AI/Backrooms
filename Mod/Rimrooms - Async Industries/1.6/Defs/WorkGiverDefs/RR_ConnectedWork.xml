<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Each connected family is registered twice, because starting a trip and
       finishing one need opposite priorities.

       Finishing sits high: a worker standing on the far side holding cargo must not
       lose to routine local hauling and abandon the delivery. It is placed above
       Core's HaulCorpses (90) and below Strip (100) and HaulToPortal (105).

       Starting sits just below Core's HaulGeneral (15), so ordinary local hauling is
       always preferred and a trip through a gate only happens when there is nothing
       closer to do. Both values are balance decisions and are recorded as such; they
       are subject to the owner's runtime acceptance. -->

  <!-- Construction supply sits around Core's own delivery givers, which are in the
       Hauling work type at 10 (frames) and 9 (blueprints). Finishing a delivery already
       in hand edges above them; starting one sits below, so material already on this side
       is always delivered first. Balance decisions, recorded as such. -->

  <WorkGiverDef>
    <defName>RR_ConnectedConstructionContinue</defName>
    <label>finish delivering material through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedConstructionContinue</giverClass>
    <workType>Hauling</workType>
    <verb>deliver</verb>
    <gerund>delivering</gerund>
    <priorityInType>12</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RR_ConnectedConstruction</defName>
    <label>carry material to a site through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedConstruction</giverClass>
    <workType>Hauling</workType>
    <verb>deliver</verb>
    <gerund>delivering</gerund>
    <priorityInType>8</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- Travel-to-work is a different shape from every family above: the worker goes and
       nothing is carried. The only job either of these ever hands out is a crossing.
       Once the worker has arrived they hand out nothing at all, and Core's own
       ConstructFinishFrames (Construction 80) does the building, locally, with its own
       reservations and its own toils.

       Core's Construction work type runs 120 FixBrokenDownBuilding, 110 Uninstall,
       100 BuildRoofs, 90 RemoveRoofs, 85 DeconstructForBlueprint, 80 ConstructFinishFrames,
       70 DeliverResourcesToFrames, 60 DeliverResourcesToBlueprints, 51 FillIn,
       50 Deconstruct, 40 Repair, 30 RemoveFoundations/RemoveFloors, 20 SmoothFloors,
       10 SmoothWalls.

       Continuing sits at 82: above frame finishing, so a builder partway to a gate is not
       turned around by a frame that appeared at home while it walked, but still below
       clearing a blueprint site (85), roof work, uninstalls and breakdown repair, which
       are either more urgent or block other work outright.

       Starting sits at 5, below every single one of those. Crossing a gate to build
       therefore only ever happens when there is nothing constructive left to do on this
       side at all - not even smoothing a wall. Both values are balance decisions and are
       recorded as such; they are subject to the owner's runtime acceptance. -->

  <WorkGiverDef>
    <defName>RR_ConnectedConstructionFinishingContinue</defName>
    <label>travel on to finish a build through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedConstructionFinishingContinue</giverClass>
    <workType>Construction</workType>
    <verb>construct</verb>
    <gerund>constructing</gerund>
    <priorityInType>82</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RR_ConnectedConstructionFinishing</defName>
    <label>cross a gate to finish a build</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedConstructionFinishing</giverClass>
    <workType>Construction</workType>
    <verb>construct</verb>
    <gerund>constructing</gerund>
    <priorityInType>5</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- Research is the second travel-to-work provider, and it needed no new record, driver
       or JobDef - only a different answer to "is there work of my kind over there". On
       arrival it issues nothing and whatever research giver is active on that map does the
       work, which is why a profile that changes how research is chosen or presented changes
       nothing here.

       Core's Research work type runs 130 Hack, 120 CreateXenogerm,
       110 StudyArchotechStructures, 100 Research, 50 LongRangeScan, 50 GroundPenetratingScan.

       Continuing sits at 102: above ordinary research so a researcher partway to a gate is
       not turned around by a bench freeing up at home, and below archotech study, xenogerm
       creation and hacking, which are more urgent or time-limited.

       Starting sits at 40, below every Core research giver including both scans, so crossing
       a gate to research only happens when there is nothing to research on this side.
       Balance decisions, recorded as such, and player-tunable while the game runs. -->

  <WorkGiverDef>
    <defName>RR_ConnectedResearchContinue</defName>
    <label>travel on to research through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedResearchContinue</giverClass>
    <workType>Research</workType>
    <verb>research</verb>
    <gerund>researching</gerund>
    <priorityInType>102</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RR_ConnectedResearch</defName>
    <label>cross a gate to research</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedResearch</giverClass>
    <workType>Research</workType>
    <verb>research</verb>
    <gerund>researching</gerund>
    <priorityInType>40</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- Bill ingredients sit just under construction supply in Hauling. A stalled build is
       more urgent than a stalled bill, so material to a frame is preferred; both stay well
       below Core's own HaulGeneral (15) so ordinary local hauling always wins. Finishing a
       delivery already in hand edges above the construction pair for the same reason it does
       everywhere: cargo in real hands must not be abandoned. Balance decisions, recorded as
       such, and all eight cross-gate numbers are player settings as of 0.5.6-dev. -->

  <WorkGiverDef>
    <defName>RR_ConnectedBillContinue</defName>
    <label>finish delivering ingredients through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedBillContinue</giverClass>
    <workType>Hauling</workType>
    <verb>deliver</verb>
    <gerund>delivering</gerund>
    <priorityInType>11</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RR_ConnectedBill</defName>
    <label>carry ingredients to a bill through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedBill</giverClass>
    <workType>Hauling</workType>
    <verb>deliver</verb>
    <gerund>delivering</gerund>
    <priorityInType>7</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <!-- Casualties sit around Core's own DoctorRescue (60): finishing a trip that
       already has someone in the worker's arms edges above it, starting one sits just
       below so a casualty on this map is always rescued first. Both stay under the
       more urgent doctor work above 70. Balance decisions, recorded as such. -->

  <WorkGiverDef>
    <defName>RR_ConnectedCasualtyContinue</defName>
    <label>finish carrying a casualty home</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedCasualtyContinue</giverClass>
    <workType>Doctor</workType>
    <verb>carry</verb>
    <gerund>carrying</gerund>
    <priorityInType>65</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RR_ConnectedCasualty</defName>
    <label>carry casualties home through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedCasualty</giverClass>
    <workType>Doctor</workType>
    <verb>rescue</verb>
    <gerund>rescuing</gerund>
    <priorityInType>59</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RR_ConnectedHaulingContinue</defName>
    <label>finish hauling through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedHaulingContinue</giverClass>
    <workType>Hauling</workType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <priorityInType>95</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RR_ConnectedHauling</defName>
    <label>haul through a gate</label>
    <giverClass>RimroomsAsyncIndustries.ConnectedWork.WorkGiver_ConnectedHauling</giverClass>
    <workType>Hauling</workType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <priorityInType>14</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>

</Defs>
