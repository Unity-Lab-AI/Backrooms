<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Surveying a door for a way onward sits just above bench research. It is a
       discrete, short task that can only happen a bounded number of times per space
       (NaturalFrontierService.MaximumFrontiersPerCoordinate), so it cannot starve
       ongoing research for long. The exact value is a balance decision. -->
  <WorkGiverDef>
    <defName>RR_SurveyFrontier</defName>
    <label>survey doors for a way onward</label>
    <giverClass>RimroomsAsyncIndustries.Portals.WorkGiver_SurveyFrontier</giverClass>
    <workType>Research</workType>
    <verb>survey</verb>
    <gerund>surveying</gerund>
    <priorityInType>115</priorityInType>
    <requiredCapacities><li>Sight</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RR_CompanyLaboratory</defName>
    <label>analyze company evidence</label>
    <giverClass>RimroomsAsyncIndustries.Investigation.WorkGiver_CompanyLaboratory</giverClass>
    <workType>Research</workType>
    <verb>research at</verb>
    <gerund>researching at</gerund>
    <priorityInType>110</priorityInType>
    <requiredCapacities><li>Manipulation</li><li>Moving</li></requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>
</Defs>
