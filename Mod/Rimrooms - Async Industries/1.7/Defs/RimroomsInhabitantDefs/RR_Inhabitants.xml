    <chance>0.3</chance>
    <letterLabelKey>RR_Inhabitant_SurvivorLabel</letterLabelKey>
    <letterTextKey>RR_Inhabitant_SurvivorText</letterTextKey>
    <tellKey>RR_Inhabitant_SurvivorTell</tellKey>
  </RimroomsAsyncIndustries.Threats.RimroomsInhabitantDef>

  <RimroomsAsyncIndustries.Threats.RimroomsInhabitantDef>
