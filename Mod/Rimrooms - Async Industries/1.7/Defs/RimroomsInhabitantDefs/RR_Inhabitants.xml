    <letterLabelKey>RR_Inhabitant_MissingLabel</letterLabelKey>
    <letterTextKey>RR_Inhabitant_MissingText</letterTextKey>
    <tellKey>RR_Inhabitant_MissingTell</tellKey>
  </RimroomsAsyncIndustries.Threats.RimroomsInhabitantDef>

  <RimroomsAsyncIndustries.Threats.RimroomsInhabitantDef>
    <defName>RR_Inhabitant_Survivor</defName>
