{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rimplc.local/schema/tag.schema.json",
  "title": "RimPLC tag table (frozen v1)",
  "description": "Constants are safety limits (owner only). Variables are setpoints recomputed each scan from the colony's size where a rule exists, clamped to min/max; an override wins inside the bounds. Reference in a condition as {NAME}, or use NAME as a when key.",
  "type": "object",
  "required": ["constants", "variables"],
  "additionalProperties": false,
  "properties": {
    "note": {"type": "string"},
    "constants": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"type": ["number", "boolean", "string", "array"]}
    },
    "variables": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/variable"}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Z0-9_]{1,40}$"},
    "variable": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number"},
        "rule": {"type": "string"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "owner_only": {"type": "boolean"}
      }
    }
  }
}
