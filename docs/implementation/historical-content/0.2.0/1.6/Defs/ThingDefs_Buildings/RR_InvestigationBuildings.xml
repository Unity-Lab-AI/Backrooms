<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RR_FieldAnalysisBench</defName>
    <label>legacy field analysis bench</label>
    <description>Historical development-build furniture retained to avoid silently removing an object from an earlier save. It no longer supplies company research and cannot be newly built. Designate an existing simple or hi-tech research bench in Operations / Investigation for company analysis and research.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Buildings/Lab/RR_FieldAnalysisBench</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.7,2.7)</drawSize>
    </graphicData>
    <size>(2,1)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>35</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList><Steel>90</Steel><ComponentIndustrial>4</ComponentIndustrial></costList>
    <building><isEdifice>true</isEdifice></building>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>250</basePowerConsumption><shortCircuitInRain>true</shortCircuitInRain></li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
  </ThingDef>
</Defs>
