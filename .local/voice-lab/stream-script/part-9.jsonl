{"text": "Where's Odessa?", "emotion": "concerned", "speech_act": "wh_question"}
{"text": "How bad is it?", "emotion": "concerned", "speech_act": "wh_question"}
{"text": "What's that thing?", "emotion": "concerned", "speech_act": "wh_question"}
{"text": "Who's on watch?", "emotion": "concerned", "speech_act": "wh_question"}
{"text": "Why is she shaking?", "emotion": "concerned", "speech_act": "wh_question"}
{"text": "Okay, careful now.", "emotion": "concerned", "speech_act": "aside"}
{"text": "Everyone okay over there?", "emotion": "concerned", "speech_act": "yes_no_question"}
{"text": "Don't panic.", "emotion": "concerned", "speech_act": "aside"}
{"text": "Hang in there, Juno.", "emotion": "concerned", "speech_act": "reassurance"}
{"text": "Stay calm, we've got this.", "emotion": "concerned", "speech_act": "reassurance"}
{"text": "You'll be okay, Hollis.", "emotion": "concerned", "speech_act": "reassurance"}
{"text": "Not again!", "emotion": "frustrated", "speech_act": "exclamation"}
{"text": "Every single time!", "emotion": "frustrated", "speech_act": "exclamation"}
{"text": "Seriously!", "emotion": "frustrated", "speech_act": "exclamation"}
{"text": "Unbelievable!", "emotion": "frustrated", "speech_act": "exclamation"}
{"text": "Third try.", "emotion": "frustrated", "speech_act": "statement"}
{"text": "Ugh, fine.", "emotion": "frustrated", "speech_act": "statement"}
{"text": "Rook, please!", "emotion": "frustrated", "speech_act": "exclamation"}
{"text": "Why is this so hard.", "emotion": "frustrated", "speech_act": "statement"}
