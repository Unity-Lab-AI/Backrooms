{"text": "Food's running low.", "emotion": "concerned", "speech_act": "statement"}
{"text": "I don't like that sound.", "emotion": "concerned", "speech_act": "statement"}
{"text": "Careful, Ivy!", "emotion": "concerned", "speech_act": "exclamation"}
{"text": "Rook's mood is tanking.", "emotion": "concerned", "speech_act": "statement"}
{"text": "We're low on medicine.", "emotion": "concerned", "speech_act": "statement"}
{"text": "That gate looks wrong.", "emotion": "concerned", "speech_act": "statement"}
{"text": "Something's off.", "emotion": "concerned", "speech_act": "statement"}
{"text": "Hmm, too quiet.", "emotion": "concerned", "speech_act": "statement"}
{"text": "Bram's bleeding!", "emotion": "concerned", "speech_act": "exclamation"}
{"text": "Watch the door, Scar.", "emotion": "concerned", "speech_act": "statement"}
{"text": "Is Mara okay?", "emotion": "concerned", "speech_act": "yes_no_question"}
{"text": "Are we ready for this?", "emotion": "concerned", "speech_act": "yes_no_question"}
{"text": "Is that infection?", "emotion": "concerned", "speech_act": "yes_no_question"}
{"text": "Did Tamsin eat today?", "emotion": "concerned", "speech_act": "yes_no_question"}
{"text": "Should we pull back?", "emotion": "concerned", "speech_act": "yes_no_question"}
