<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>RimroomsAsyncIndustries</AssemblyName>
    <RootNamespace>RimroomsAsyncIndustries</RootNamespace>
    <Version>0.8.6-dev</Version>
    <AssemblyVersion>0.8.6.0</AssemblyVersion>
    <FileVersion>0.7.1.0</FileVersion>
    <Authors>Operator</Authors>
    <Company>Operator</Company>
    <Product>Rimrooms - Async Industries</Product>
    <Description>RimWorld company campaign development build.</Description>
    <Copyright>Copyright (c) 2026 Operator</Copyright>
    <Deterministic>true</Deterministic>
    <!-- The SDK otherwise appends the git commit to AssemblyInformationalVersion, which
         makes the assembly hash a function of source AND commit. That silently defeated the
         evidence ritual: a recorded hash could never be re-verified after the commit that
         contained it, because creating that commit changed what a rebuild produces. With
         this off the hash is a pure function of the source and stays verifiable forever. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">$(RIMWORLD_PATH)</RimWorldPath>
    <RimWorldManagedPath>$(RimWorldPath)/RimWorldWin64_Data/Managed</RimWorldManagedPath>
    <PathMap>$(MSBuildProjectDirectory)=/src/RimroomsAsyncIndustries</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireLocalGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RimWorldPath)' == ''" Text="Set RimWorldPath or RIMWORLD_PATH to the installed RimWorld directory. See docs/BUILDING.md." />
    <Error Condition="!Exists('$(RimWorldManagedPath)/Assembly-CSharp.dll')" Text="RimWorld 1.6 managed references are missing from $(RimWorldManagedPath). Do not download or commit game binaries." />
  </Target>
</Project>
